<?xml version="1.0" encoding="UTF-8"?>
<!-- One abstract message structure, with a segment group. The group's
     element is named for the structure it belongs to; the dictionary keeps
     only the part after the prefix. -->
<xsd:schema xmlns="urn:hl7-org:v2xml" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:hl7-org:v2xml">
    <xsd:include schemaLocation="2_5_segments.xsd"/>
    <xsd:complexType name="ADT_A39.CONTENT">
        <xsd:sequence>
            <xsd:element ref="MSH"/>
            <xsd:element ref="EVN"/>
            <xsd:element maxOccurs="unbounded" ref="ADT_A39.PATIENT"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="ADT_A39" type="ADT_A39.CONTENT"/>
    <xsd:complexType name="ADT_A39.PATIENT.CONTENT">
        <xsd:sequence>
            <xsd:element ref="PID"/>
            <xsd:element ref="MRG"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="ADT_A39.PATIENT" type="ADT_A39.PATIENT.CONTENT"/>
</xsd:schema>
