/target

# Shared editor configuration (extensions, tasks, debug launch) is tracked,
# even where a contributor's global gitignore hides .vscode.
!/.vscode/

# cargo-fuzz working state: the built fuzzers, the corpus they grow, and
# the inputs they save when a target fails. The targets themselves and
# their Cargo.toml are tracked; none of this is.
*/fuzz/target
*/fuzz/corpus
*/fuzz/artifacts
*/fuzz/Cargo.lock

# Python bytecode, from helper scripts run at the workspace root.
__pycache__/
*.pyc
