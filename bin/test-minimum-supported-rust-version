#!/usr/bin/env bash
# Check and test the workspace on its MSRV and on the following Rust minor.
set -euo pipefail

cd "$(dirname "$0")/.."

msrv=$(sed -nE 's/^rust-version[[:space:]]*=[[:space:]]*"([0-9]+\.[0-9]+)".*/\1/p' Cargo.toml)
if [[ -z "$msrv" ]]; then
  echo "error: no literal rust-version found in the workspace Cargo.toml" >&2
  exit 1
fi
major=${msrv%%.*}
minor=${msrv##*.}
n_minus_1="$major.$((minor + 1))"

# A minor alias (1.98) and a patch-specific installation (1.98.1) have
# different rustup names. Resolve each candidate for rustup's default host.
installed=$(rustup toolchain list)
for version in "$msrv" "$n_minus_1"; do
  toolchain=
  while read -r name _; do
    release=${name%%-*}
    case "$release" in
      "$version"|"$version".[0-9]*) ;;
      *) continue ;;
    esac
    if rustup run "$release" rustc --version >/dev/null 2>&1; then
      toolchain=$release
      break
    fi
  done <<< "$installed"
  if [[ -z "$toolchain" ]]; then
    echo "error: install a native toolchain for Rust $version with rustup toolchain install $version" >&2
    exit 1
  fi
  echo "==> $toolchain: workspace"
  cargo "+$toolchain" check --locked --workspace --all-targets
  cargo "+$toolchain" test --locked --workspace

  for manifest in */fuzz/Cargo.toml; do
    echo "==> $toolchain: ${manifest%/Cargo.toml}"
    (cd "${manifest%/Cargo.toml}" && cargo "+$toolchain" check --all-targets)
  done
done
echo "OK: MSRV $msrv and N-1 $n_minus_1 pass"
