#!/bin/sh
# Publish a monorepo subdirectory to a sibling GitHub Pages repository via
# git subtree, without rewriting history.
#
# Delegated to from `make github-pages` (see the Makefile for this
# repository's actual prefix, remote, and branch); the convention itself —
# shared with the sibling repos in this posture (er7-rust, fhir-rust,
# snomed-rust, openehr-rust) — is spec/monorepo-github-pages/index.md.
#
# Usage: bin/make-github-pages <prefix> <remote> <branch>
#
#   prefix  The subdirectory holding the GitHub Pages subproject, e.g.
#           hl7-rust.github.io.
#   remote  The git remote pointed at the sibling repository. The
#           Makefile adds it first if the clone does not have it yet.
#   branch  The branch on that remote to push to, normally main.
#
# `git subtree push` only fast-forwards: it refuses rather than silently
# overwriting if the remote branch's history has diverged (a direct
# commit made there instead of in this subdirectory, say) — see
# spec/monorepo-github-pages/index.md's "never work directly in [the
# published repository]" rule for why that should not happen in the
# first place.

set -eu

if [ "$#" -ne 3 ]; then
  echo "usage: $0 <prefix> <remote> <branch>" >&2
  exit 1
fi

prefix=$1
remote=$2
branch=$3

git subtree push --prefix="$prefix" "$remote" "$branch"
